{
  "design_html": "<div class=\"sl\"><style>.sl{background:hsl(var(--background));color:hsl(var(--foreground));min-height:100%;line-height:1.5}.sl *{box-sizing:border-box}.sl a{color:inherit;text-decoration:none}.sl-w{max-width:72rem;margin:0 auto;padding:0 1.5rem}.sl-nav{background:hsl(var(--card));border-bottom:1px solid hsl(var(--border));position:sticky;top:0;z-index:5}.sl-nav .sl-w{display:flex;align-items:center;justify-content:space-between;height:4rem}.sl-brand{display:flex;align-items:center;gap:.5rem;font-weight:700;font-size:1.125rem;letter-spacing:-.01em}.sl-links{display:flex;gap:1.75rem;font-size:.875rem;color:hsl(var(--muted-foreground))}.sl-links a:hover{color:hsl(var(--foreground))}.sl-nr{display:flex;gap:.75rem;align-items:center}.sl-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.75rem;padding:0 1.25rem;border-radius:var(--radius);background:hsl(var(--primary));color:hsl(var(--primary-foreground));font-size:.875rem;font-weight:500;border:1px solid transparent;cursor:pointer;box-shadow:var(--shadow-sm)}.sl-btn.o{background:transparent;color:hsl(var(--foreground));border-color:hsl(var(--border));box-shadow:none}.sl-btn.s{height:2.25rem;font-size:.8125rem;padding:0 .875rem}.sl-hero{padding:4.5rem 0 3.5rem}.sl-hg{display:grid;grid-template-columns:1.05fr 1fr;gap:3rem;align-items:center}.sl-badge{display:inline-flex;align-items:center;gap:.4rem;padding:.25rem .75rem;border-radius:9999px;background:hsl(var(--primary) / 0.1);color:hsl(var(--primary));font-size:.75rem;font-weight:600}.sl h1{font-size:3rem;line-height:1.1;font-weight:700;letter-spacing:-.025em;margin:1.25rem 0 1rem}.sl-lead{font-size:1.125rem;color:hsl(var(--muted-foreground));max-width:34rem}.sl-cta{display:flex;gap:.75rem;margin-top:2rem;flex-wrap:wrap}.sl-note{font-size:.8125rem;color:hsl(var(--muted-foreground));margin-top:1rem}.sl-card{background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:1.5rem}.sl-card.l{box-shadow:var(--shadow-lg)}.sl-hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}.sl-cap{font-size:.75rem;color:hsl(var(--muted-foreground))}.sl h2{font-size:2rem;font-weight:700;letter-spacing:-.02em;line-height:1.2}.sl h3{font-size:1.0625rem;font-weight:600;line-height:1.3}.sl-sec{padding:3.5rem 0}.sl-sh{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;margin-bottom:2.5rem}.sl-sh p{color:hsl(var(--muted-foreground));max-width:26rem;font-size:.9375rem}.sl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}.sl-feat p{font-size:.875rem;color:hsl(var(--muted-foreground));margin-top:.5rem}.sl-ic{width:2.5rem;height:2.5rem;border-radius:var(--radius);background:hsl(var(--primary) / 0.1);color:hsl(var(--primary));display:flex;align-items:center;justify-content:center;margin-bottom:1rem}.sl-ic svg{width:1.25rem;height:1.25rem}.sl-muted{background:hsl(var(--muted) / 0.5);border-top:1px solid hsl(var(--border));border-bottom:1px solid hsl(var(--border))}.sl-tw{display:grid;grid-template-columns:1.2fr 1fr;gap:1.25rem}.sl-row{display:grid;grid-template-columns:1.4fr 1fr .8fr .9fr;align-items:center;gap:1rem;padding:.875rem 0;border-bottom:1px solid hsl(var(--border));font-size:.875rem}.sl-row:last-child{border-bottom:0}.sl-row.h{font-size:.75rem;color:hsl(var(--muted-foreground));padding-top:0}.sl-sb{display:inline-flex;padding:.2rem .6rem;border-radius:9999px;font-size:.75rem;font-weight:500;background:hsl(var(--secondary));color:hsl(var(--secondary-foreground))}.sl-sb.p{background:hsl(var(--primary) / 0.1);color:hsl(var(--primary))}.sl-sb.d{background:hsl(var(--destructive) / 0.1);color:hsl(var(--destructive))}.sl code{font-size:.75rem;background:hsl(var(--muted));padding:.1rem .4rem;border-radius:calc(var(--radius) - 2px)}.sl-kpi{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:1.25rem}.sl-kpi div{border:1px solid hsl(var(--border));border-radius:calc(var(--radius) - 2px);padding:.875rem}.sl-kpi strong{display:block;font-size:1.25rem;font-weight:700}.sl-kpi span{font-size:.75rem;color:hsl(var(--muted-foreground))}.sl-tip{margin-top:1rem;padding:.875rem 1rem;border-radius:calc(var(--radius) - 2px);background:hsl(var(--primary) / 0.08);font-size:.8125rem}.sl-foot{padding:2.5rem 0;border-top:1px solid hsl(var(--border));background:hsl(var(--card))}.sl-fg{display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap;font-size:.8125rem;color:hsl(var(--muted-foreground))}.sl-fg nav{display:flex;gap:1.5rem}@media(max-width:860px){.sl-hg,.sl-tw{grid-template-columns:1fr}.sl-grid{grid-template-columns:1fr 1fr}.sl h1{font-size:2.25rem}.sl-links{display:none}}</style><header class=\"sl-nav\"><div class=\"sl-w\"><a class=\"sl-brand\" href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\"><rect width=\"24\" height=\"24\" rx=\"6\" fill=\"hsl(var(--primary))\"/><path d=\"M7 7v10h10\" stroke=\"hsl(var(--primary-foreground))\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M11 13l3-3 2 2\" stroke=\"hsl(var(--primary-foreground))\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>SoloLedger</a><nav class=\"sl-links\"><a href=\"#\">Features</a><a href=\"#\">Cash flow</a><a href=\"#\">Clients</a><a href=\"#\">Pricing</a><a href=\"#\">Resources</a></nav><div class=\"sl-nr\"><a class=\"sl-btn o s\" href=\"#\">Log in</a><a class=\"sl-btn s\" href=\"#\">Start free</a></div></div></header><main><section class=\"sl-hero\"><div class=\"sl-w sl-hg\"><div><span class=\"sl-badge\">● Cash flow forecast updated 8 min ago</span><h1>See every payment coming in, before rent is due.</h1><p class=\"sl-lead\">SoloLedger is a financial co-pilot for freelancers. Track invoices, expenses and pending payments in one ledger, then plan your cash flow with confidence.</p><div class=\"sl-cta\"><a class=\"sl-btn\" href=\"#\">Start free trial</a><a class=\"sl-btn o\" href=\"#\">Book a 15‑min demo</a></div><p class=\"sl-note\">Free for your first 3 clients. No credit card required.</p></div><div class=\"sl-card l\"><div class=\"sl-hd\"><div><h3>Financial health</h3><span class=\"sl-cap\">Last 30 days · Q3 pipeline</span></div><span class=\"sl-sb p\">On track</span></div><div style=\"display:none\"></div><svg width=\"100%\" viewBox=\"0 0 320 140\" fill=\"none\"><g fill=\"hsl(var(--primary) / 0.25)\"><rect x=\"10\" y=\"70\" width=\"28\" height=\"60\" rx=\"6\"/><rect x=\"50\" y=\"50\" width=\"28\" height=\"80\" rx=\"6\"/><rect x=\"90\" y=\"60\" width=\"28\" height=\"70\" rx=\"6\"/><rect x=\"130\" y=\"30\" width=\"28\" height=\"100\" rx=\"6\"/><rect x=\"170\" y=\"45\" width=\"28\" height=\"85\" rx=\"6\"/></g><rect x=\"210\" y=\"20\" width=\"28\" height=\"110\" rx=\"6\" fill=\"hsl(var(--primary))\"/><rect x=\"250\" y=\"40\" width=\"28\" height=\"90\" rx=\"6\" fill=\"hsl(var(--primary) / 0.25)\"/><line x1=\"0\" y1=\"130\" x2=\"320\" y2=\"130\" stroke=\"hsl(var(--border))\"/></svg><div class=\"sl-kpi\"><div><strong>$14,820</strong><span>Expected in next 30 days</span></div><div><strong>82 / 100</strong><span>Health score</span></div></div><p class=\"sl-tip\">Recommendation: Send the Acme invoice today. Early payment would cover your Q4 tooling costs.</p></div></div></section><section class=\"sl-sec sl-muted\"><div class=\"sl-w\"><div class=\"sl-sh\"><div><h2>Everything a solo business runs on</h2></div><p>One calm workspace for clients, billing, spending and the numbers that decide what you can afford next.</p></div><div class=\"sl-grid\"><article class=\"sl-card sl-feat\"><div class=\"sl-ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3 20c0-3 3-5 6-5s6 2 6 5M16 11l2 2 4-4\"/></svg></div><h3>Manage clients</h3><p>Rates, contacts and payment terms stored once and reused on every invoice.</p></article><article class=\"sl-card sl-feat\"><div class=\"sl-ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 3h9l4 4v14H6z\"/><path d=\"M9 12h7M9 16h5\"/></svg></div><h3>Manage invoices</h3><p>Create, send and chase invoices with automatic reminders before they slip.</p></article><article class=\"sl-card sl-feat\"><div class=\"sl-ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 10h18M8 15h3\"/></svg></div><h3>Track expenses</h3><p>Snap receipts, tag software and hardware, and see deductible totals at a glance.</p></article><article class=\"sl-card sl-feat\"><div class=\"sl-ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 17l6-6 4 4 8-8\"/><path d=\"M15 7h6v6\"/></svg></div><h3>Forecast cash flow</h3><p>Projected balance day by day, based on invoices due and your recurring costs.</p></article><article class=\"sl-card sl-feat\"><div class=\"sl-ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 4v16h16\"/><path d=\"M8 14l3-3 3 3 5-6\"/></svg></div><h3>Simulate what-if scenarios</h3><p>Model a late payment or a new retainer and see how runway changes.</p></article><article class=\"sl-card sl-feat\"><div class=\"sl-ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg></div><h3>Financial health score</h3><p>A single 0–100 score with the three levers most likely to move it this month.</p></article></div></div></section><section class=\"sl-sec\"><div class=\"sl-w sl-tw\"><div class=\"sl-card\"><div class=\"sl-hd\"><div><h2 style=\"font-size:1.5rem\">Pending payments</h2><span class=\"sl-cap\">4 invoices · $9,640 outstanding</span></div><a class=\"sl-btn o s\" href=\"#\">View all</a></div><div class=\"sl-row h\"><span>Client</span><span>Invoice</span><span>Amount</span><span>Status</span></div><div class=\"sl-row\"><span>Northwind Labs</span><code>INV-1042</code><span>$3,200</span><span class=\"sl-sb p\">Due in 3 days</span></div><div class=\"sl-row\"><span>Hale &amp; Co. Design</span><code>INV-1038</code><span>$2,140</span><span class=\"sl-sb\">Sent</span></div><div class=\"sl-row\"><span>Brightwave Media</span><code>INV-1031</code><span>$1,800</span><span class=\"sl-sb d\">Overdue 4 days</span></div><div class=\"sl-row\"><span>Acme Co.</span><code>INV-1027</code><span>$2,500</span><span class=\"sl-sb\">Draft</span></div></div><div class=\"sl-card\"><div class=\"sl-hd\"><div><h2 style=\"font-size:1.5rem\">What if?</h2><span class=\"sl-cap\">Scenario: Brightwave pays late</span></div><span class=\"sl-sb\">Simulation</span></div><p style=\"font-size:.9375rem;color:hsl(var(--muted-foreground))\">If Brightwave pays 30 days late, your lowest balance drops to $4,310 on Oct 14. Adding one 2‑day project would keep you above $6,000.</p><div class=\"sl-kpi\"><div><strong>$4,310</strong><span>Lowest balance (scenario)</span></div><div><strong>12 days</strong><span>Runway with no new income</span></div></div><div class=\"sl-cta\"><a class=\"sl-btn s\" href=\"#\">Run another scenario</a></div></div></div></section></main><footer class=\"sl-foot\"><div class=\"sl-w sl-fg\"><span class=\"sl-brand\" style=\"font-size:1rem\">SoloLedger</span><nav><a href=\"#\">Privacy</a><a href=\"#\">Terms</a><a href=\"#\">Security</a><a href=\"#\">Status</a></nav><span>© 2025 SoloLedger. Built for independent work.</span></div></footer></div>",
